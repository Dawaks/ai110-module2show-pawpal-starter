classDiagram
    class Owner {
        +name
        +pets
        +add_pet(pet)
        +get_all_tasks()
    }

    class Pet {
        +name
        +species
        +tasks
        +add_task(task)
    }

    class Task {
        +description
        +time
        +frequency
        +completed
        +mark_complete()
    }

    class Scheduler {
        +owner
        +sort_by_time()
        +filter_tasks()
        +detect_conflicts()
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler --> Owner : uses
